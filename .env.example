# Discord user token (from browser DevTools — see README)
DISCORD_TOKEN=

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your Telegram chat/channel ID where to send notifications
TELEGRAM_CHAT_ID=

# Comma-separated Discord channel IDs to monitor
CHANNEL_IDS=123456789012345678,987654321098765432

# Optional: only forward messages containing these words (leave empty = forward all)
KEYWORDS=
